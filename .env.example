# Facebook Page & Instagram Business (shared Graph API token)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Threads API (separate host and token)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Public URL where Express serves uploaded images (must be reachable by Meta)
PUBLIC_BASE_URL=

# Meta Graph API version (e.g. v22.0)
META_GRAPH_API_VERSION=

# Local server port (optional, defaults to 3000)
PORT=
