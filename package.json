{
  "name": "social-media-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc && tsc -p tsconfig.public.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.public.json --noEmit",
    "test": "tsc -p tsconfig.public.json && tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
